          }
        ],
        "partitions": [
          {
            "name": "Fakt_Pogoda_Stacje",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Zrodlo = Odbc.Query(\"Driver={SQLite3 ODBC Driver};Database=\" & PlikBazy, \"SELECT * FROM pbi_fakt_pogoda_stacje\"),",
                "    Typy = Table.TransformColumnTypes(Zrodlo, {{\"Data\", type date}, {\"Godzina\", Int64.Type}, {\"IdStacji\", type text}, {\"Temperatura_C\", type number}, {\"Wiatr_100m_ms\", type number}, {\"Promieniowanie_Wm2\", type number}, {\"Zachmurzenie_proc\", type number}}, \"en-US\")",
                "in",
                "    Typy"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Temperatura w stacji (°C)",
            "expression": "AVERAGE(Fakt_Pogoda_Stacje[Temperatura_C])",
            "formatString": "0.0"
          },
          {
            "name": "Wiatr w stacji (m/s)",
            "expression": "AVERAGE(Fakt_Pogoda_Stacje[Wiatr_100m_ms])",
            "formatString": "0.0"
          },
          {
            "name": "Promieniowanie w stacji (W/m²)",
            "expression": "AVERAGE(Fakt_Pogoda_Stacje[Promieniowanie_Wm2])",
            "formatString": "#,0"
          }
        ]
      },
      {
        "name": "Fakt_Prognoza",
        "columns": [
          {
            "name": "CzasLokalny",
            "dataType": "dateTime",
            "sourceColumn": "CzasLokalny",
            "summarizeBy": "none",
            "formatString": "yyyy-mm-dd hh:nn"
          },
          {
            "name": "Data",
            "dataType": "dateTime",
            "sourceColumn": "Data",
            "summarizeBy": "none",
            "formatString": "yyyy-mm-dd"
          },
          {
            "name": "Godzina",
            "dataType": "int64",
            "sourceColumn": "Godzina",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "Rzeczywiste_MW",
            "dataType": "double",
            "sourceColumn": "Rzeczywiste_MW",
            "summarizeBy": "sum",
            "formatString": "#,0.0"
          },
          {
            "name": "Prognoza_PSE_MW",
            "dataType": "double",
            "sourceColumn": "Prognoza_PSE_MW",
            "summarizeBy": "sum",
            "formatString": "#,0.0"
          },
          {
            "name": "Prognoza_Naiwna_MW",
            "dataType": "double",
            "sourceColumn": "Prognoza_Naiwna_MW",
            "summarizeBy": "sum",
            "formatString": "#,0.0"
          },
          {
            "name": "Prognoza_Model_MW",
            "dataType": "double",
            "sourceColumn": "Prognoza_Model_MW",
            "summarizeBy": "sum",
            "formatString": "#,0.0"
          }
        ],
        "partitions": [
          {
            "name": "Fakt_Prognoza",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Zrodlo = Odbc.Query(\"Driver={SQLite3 ODBC Driver};Database=\" & PlikBazy, \"SELECT * FROM pbi_fakt_prognoza\"),",
                "    Typy = Table.TransformColumnTypes(Zrodlo, {{\"CzasLokalny\", type datetime}, {\"Data\", type date}, {\"Godzina\", Int64.Type}, {\"Rzeczywiste_MW\", type number}, {\"Prognoza_PSE_MW\", type number}, {\"Prognoza_Naiwna_MW\", type number}, {\"Prognoza_Model_MW\", type number}}, \"en-US\")",
                "in",
                "    Typy"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Zapotrzebowanie rzeczywiste (MW)",
            "expression": "AVERAGE(Fakt_Prognoza[Rzeczywiste_MW])",
            "formatString": "#,0"
          },
          {
            "name": "Prognoza modelu (MW)",
            "expression": "AVERAGE(Fakt_Prognoza[Prognoza_Model_MW])",
            "formatString": "#,0"
          },
          {
            "name": "Prognoza PSE (MW)",
            "expression": "AVERAGE(Fakt_Prognoza[Prognoza_PSE_MW])",
            "formatString": "#,0"
          },
          {
            "name": "MAPE modelu (%)",
            "expression": "AVERAGEX(Fakt_Prognoza, DIVIDE(ABS(Fakt_Prognoza[Prognoza_Model_MW] - Fakt_Prognoza[Rzeczywiste_MW]), Fakt_Prognoza[Rzeczywiste_MW]))",
            "formatString": "0.00%"
          },
          {
            "name": "MAPE PSE (%)",
            "expression": "AVERAGEX(Fakt_Prognoza, DIVIDE(ABS(Fakt_Prognoza[Prognoza_PSE_MW] - Fakt_Prognoza[Rzeczywiste_MW]), Fakt_Prognoza[Rzeczywiste_MW]))",
            "formatString": "0.00%"
          },
          {
            "name": "MAPE prognozy naiwnej (%)",
            "expression": "AVERAGEX(Fakt_Prognoza, DIVIDE(ABS(Fakt_Prognoza[Prognoza_Naiwna_MW] - Fakt_Prognoza[Rzeczywiste_MW]), Fakt_Prognoza[Rzeczywiste_MW]))",
            "formatString": "0.00%"
          },
          {
            "name": "MAE modelu (MW)",
            "expression": "AVERAGEX(Fakt_Prognoza, ABS(Fakt_Prognoza[Prognoza_Model_MW] - Fakt_Prognoza[Rzeczywiste_MW]))",
            "formatString": "#,0"
          },
          {
            "name": "MAE PSE (MW)",
            "expression": "AVERAGEX(Fakt_Prognoza, ABS(Fakt_Prognoza[Prognoza_PSE_MW] - Fakt_Prognoza[Rzeczywiste_MW]))",
            "formatString": "#,0"
          }
        ]
      },
      {
        "name": "Fakt_Symulacja",
        "columns": [
          {
            "name": "Data",
            "dataType": "dateTime",
            "sourceColumn": "Data",
            "summarizeBy": "none",
            "formatString": "yyyy-mm-dd"
          },
          {
            "name": "Godzina",
            "dataType": "int64",
            "sourceColumn": "Godzina",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "Zmiana_C",
            "dataType": "int64",
            "sourceColumn": "Zmiana_C",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "Prognoza_MW",
            "dataType": "double",
            "sourceColumn": "Prognoza_MW",
            "summarizeBy": "sum",
            "formatString": "#,0.0"
          }
        ],
        "partitions": [
          {
            "name": "Fakt_Symulacja",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Zrodlo = Odbc.Query(\"Driver={SQLite3 ODBC Driver};Database=\" & PlikBazy, \"SELECT * FROM pbi_fakt_symulacja\"),",
                "    Typy = Table.TransformColumnTypes(Zrodlo, {{\"Data\", type date}, {\"Godzina\", Int64.Type}, {\"Zmiana_C\", Int64.Type}, {\"Prognoza_MW\", type number}}, \"en-US\")",
                "in",
                "    Typy"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Prognoza bazowa (MW)",
            "expression": "CALCULATE(AVERAGE(Fakt_Symulacja[Prognoza_MW]), Fakt_Symulacja[Zmiana_C] = 0)",
            "formatString": "#,0"
          },
          {
            "name": "Prognoza przy zmianie temperatury (MW)",
            "expression": [
              "VAR Zmiana = [Wybrana zmiana temperatury (°C)]",
              "RETURN CALCULATE(AVERAGE(Fakt_Symulacja[Prognoza_MW]), Fakt_Symulacja[Zmiana_C] = Zmiana)"
            ],
            "formatString": "#,0"
          },
          {
            "name": "Zmiana zapotrzebowania (%)",
            "expression": "DIVIDE([Prognoza przy zmianie temperatury (MW)] - [Prognoza bazowa (MW)], [Prognoza bazowa (MW)])",
            "formatString": "+0.00%;-0.00%;0.00%"
          }
        ]
      },
      {
        "name": "Dim_Kalendarz",
        "columns": [
          {
            "name": "Data",
            "dataType": "dateTime",
            "sourceColumn": "Data",
            "summarizeBy": "none",
            "formatString": "yyyy-mm-dd",
            "isKey": true
          },
          {
            "name": "Rok",
            "dataType": "int64",
            "sourceColumn": "Rok",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "Kwartal",
            "dataType": "string",
            "sourceColumn": "Kwartal",
            "summarizeBy": "none"
          },
          {
            "name": "MiesiacNr",
            "dataType": "int64",
            "sourceColumn": "MiesiacNr",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "Miesiac",
            "dataType": "string",
            "sourceColumn": "Miesiac",
            "summarizeBy": "none",
            "sortByColumn": "MiesiacNr"
          },
          {
            "name": "RokMiesiac",
            "dataType": "string",
            "sourceColumn": "RokMiesiac",
            "summarizeBy": "none"
          },
          {
            "name": "PoczatekMiesiaca",
            "dataType": "dateTime",
            "sourceColumn": "PoczatekMiesiaca",
            "summarizeBy": "none",
            "formatString": "yyyy-mm-dd"
          },
          {
            "name": "DzienTygodniaNr",
            "dataType": "int64",
            "sourceColumn": "DzienTygodniaNr",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "DzienTygodnia",
            "dataType": "string",
            "sourceColumn": "DzienTygodnia",
            "summarizeBy": "none",
            "sortByColumn": "DzienTygodniaNr"
          },
          {
            "name": "Sezon",
            "dataType": "string",
            "sourceColumn": "Sezon",
            "summarizeBy": "none"
          },
          {
            "name": "TypDnia",
            "dataType": "string",
            "sourceColumn": "TypDnia",
            "summarizeBy": "none"
          },
          {
            "name": "NazwaSwieta",
            "dataType": "string",
            "sourceColumn": "NazwaSwieta",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Dim_Kalendarz",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
