{
  "compatibilityLevel": 1567,
  "model": {
    "culture": "pl-PL",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "pl-PL",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "tables": [
      {
        "name": "Fakt_KSE_Godzinowy",
        "columns": [
          {
            "name": "CzasLokalny",
            "dataType": "dateTime",
            "sourceColumn": "CzasLokalny",
            "summarizeBy": "none",
            "formatString": "yyyy-mm-dd hh:nn"
          },
          {
            "name": "Data",
            "dataType": "dateTime",
            "sourceColumn": "Data",
            "summarizeBy": "none",
            "formatString": "yyyy-mm-dd"
          },
          {
            "name": "Godzina",
            "dataType": "int64",
            "sourceColumn": "Godzina",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "Zapotrzebowanie_MW",
            "dataType": "double",
            "sourceColumn": "Zapotrzebowanie_MW",
            "summarizeBy": "sum",
            "formatString": "#,0.0"
          },
          {
            "name": "Prognoza_PSE_MW",
            "dataType": "string",
            "sourceColumn": "Prognoza_PSE_MW",
            "summarizeBy": "none"
          },
          {
            "name": "Generacja_Wiatr_MW",
            "dataType": "double",
            "sourceColumn": "Generacja_Wiatr_MW",
            "summarizeBy": "sum",
            "formatString": "#,0.0"
          },
          {
            "name": "Generacja_PV_MW",
            "dataType": "double",
            "sourceColumn": "Generacja_PV_MW",
            "summarizeBy": "sum",
            "formatString": "#,0.0"
          },
          {
            "name": "Zapotrzebowanie_Netto_MW",
            "dataType": "double",
            "sourceColumn": "Zapotrzebowanie_Netto_MW",
            "summarizeBy": "sum",
            "formatString": "#,0.0"
          },
          {
            "name": "Generacja_Calkowita_MW",
            "dataType": "double",
            "sourceColumn": "Generacja_Calkowita_MW",
            "summarizeBy": "sum",
            "formatString": "#,0.0"
          },
          {
            "name": "Udzial_OZE_proc",
            "dataType": "double",
            "sourceColumn": "Udzial_OZE_proc",
            "summarizeBy": "sum",
            "formatString": "#,0.0"
          },
          {
            "name": "Udzial_Wegla_proc",
            "dataType": "double",
            "sourceColumn": "Udzial_Wegla_proc",
            "summarizeBy": "sum",
            "formatString": "#,0.0"
          },
          {
            "name": "Cena_PLN_MWh",
            "dataType": "double",
            "sourceColumn": "Cena_PLN_MWh",
            "summarizeBy": "sum",
            "formatString": "#,0.0"
          },
          {
            "name": "Temperatura_C",
            "dataType": "double",
            "sourceColumn": "Temperatura_C",
            "summarizeBy": "sum",
            "formatString": "#,0.0"
          },
          {
            "name": "Wiatr_100m_ms",
            "dataType": "double",
            "sourceColumn": "Wiatr_100m_ms",
            "summarizeBy": "sum",
            "formatString": "#,0.0"
          },
          {
            "name": "Promieniowanie_Wm2",
            "dataType": "double",
            "sourceColumn": "Promieniowanie_Wm2",
            "summarizeBy": "sum",
            "formatString": "#,0.0"
          },
          {
            "name": "Zachmurzenie_proc",
            "dataType": "double",
            "sourceColumn": "Zachmurzenie_proc",
            "summarizeBy": "sum",
            "formatString": "#,0.0"
          }
        ],
        "partitions": [
          {
            "name": "Fakt_KSE_Godzinowy",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Zrodlo = Odbc.Query(\"Driver={SQLite3 ODBC Driver};Database=\" & PlikBazy, \"SELECT * FROM pbi_fakt_kse_godzinowy\"),",
                "    Typy = Table.TransformColumnTypes(Zrodlo, {{\"CzasLokalny\", type datetime}, {\"Data\", type date}, {\"Godzina\", Int64.Type}, {\"Zapotrzebowanie_MW\", type number}, {\"Prognoza_PSE_MW\", type text}, {\"Generacja_Wiatr_MW\", type number}, {\"Generacja_PV_MW\", type number}, {\"Zapotrzebowanie_Netto_MW\", type number}, {\"Generacja_Calkowita_MW\", type number}, {\"Udzial_OZE_proc\", type number}, {\"Udzial_Wegla_proc\", type number}, {\"Cena_PLN_MWh\", type number}, {\"Temperatura_C\", type number}, {\"Wiatr_100m_ms\", type number}, {\"Promieniowanie_Wm2\", type number}, {\"Zachmurzenie_proc\", type number}}, \"en-US\")",
                "in",
                "    Typy"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Średnie zapotrzebowanie (MW)",
            "expression": "AVERAGE(Fakt_KSE_Godzinowy[Zapotrzebowanie_MW])",
            "formatString": "#,0"
          },
          {
            "name": "Maksymalne zapotrzebowanie (MW)",
            "expression": "MAX(Fakt_KSE_Godzinowy[Zapotrzebowanie_MW])",
            "formatString": "#,0"
          },
          {
            "name": "Zużycie energii (GWh)",
            "expression": "SUM(Fakt_KSE_Godzinowy[Zapotrzebowanie_MW]) / 1000",
            "formatString": "#,0.0"
          },
          {
            "name": "Średnia generacja PV (MW)",
            "expression": "AVERAGE(Fakt_KSE_Godzinowy[Generacja_PV_MW])",
            "formatString": "#,0"
          },
          {
            "name": "Średnia generacja wiatrowa (MW)",
            "expression": "AVERAGE(Fakt_KSE_Godzinowy[Generacja_Wiatr_MW])",
            "formatString": "#,0"
          },
          {
            "name": "Średnie zapotrzebowanie netto (MW)",
            "expression": "AVERAGE(Fakt_KSE_Godzinowy[Zapotrzebowanie_Netto_MW])",
            "formatString": "#,0"
          },
          {
            "name": "Średnia cena (PLN/MWh)",
            "expression": "AVERAGE(Fakt_KSE_Godzinowy[Cena_PLN_MWh])",
            "formatString": "#,0"
          },
          {
            "name": "Minimalna cena (PLN/MWh)",
            "expression": "MIN(Fakt_KSE_Godzinowy[Cena_PLN_MWh])",
            "formatString": "#,0"
          },
          {
            "name": "Godziny z ceną ujemną",
            "expression": "CALCULATE(COUNTROWS(Fakt_KSE_Godzinowy), Fakt_KSE_Godzinowy[Cena_PLN_MWh] < 0) + 0",
            "formatString": "#,0"
          },
          {
            "name": "Średni udział OZE godzinowy (%)",
            "expression": "AVERAGE(Fakt_KSE_Godzinowy[Udzial_OZE_proc]) / 100",
            "formatString": "0.0%"
          },
          {
            "name": "Średnia temperatura (°C)",
            "expression": "AVERAGE(Fakt_KSE_Godzinowy[Temperatura_C])",
            "formatString": "0.0"
          },
          {
            "name": "Średnia prędkość wiatru (m/s)",
            "expression": "AVERAGE(Fakt_KSE_Godzinowy[Wiatr_100m_ms])",
            "formatString": "0.0"
          },
          {
            "name": "Średnie promieniowanie (W/m²)",
            "expression": "AVERAGE(Fakt_KSE_Godzinowy[Promieniowanie_Wm2])",
            "formatString": "#,0"
          },
          {
            "name": "Zapotrzebowanie rok do roku (%)",
            "expression": [
              "VAR Biezace = [Średnie zapotrzebowanie (MW)]",
              "VAR Poprzednie = CALCULATE([Średnie zapotrzebowanie (MW)], SAMEPERIODLASTYEAR(Dim_Kalendarz[Data]))",
              "RETURN DIVIDE(Biezace - Poprzednie, Poprzednie)"
            ],
            "formatString": "+0.0%;-0.0%;0.0%"
          }
        ]
      },
      {
        "name": "Fakt_Miks",
        "columns": [
          {
            "name": "Data",
            "dataType": "dateTime",
            "sourceColumn": "Data",
            "summarizeBy": "none",
            "formatString": "yyyy-mm-dd"
          },
          {
            "name": "Godzina",
            "dataType": "int64",
            "sourceColumn": "Godzina",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "KodZrodla",
            "dataType": "string",
            "sourceColumn": "KodZrodla",
            "summarizeBy": "none"
          },
          {
            "name": "Generacja_MW",
            "dataType": "double",
            "sourceColumn": "Generacja_MW",
            "summarizeBy": "sum",
            "formatString": "#,0.0"
          }
        ],
        "partitions": [
          {
            "name": "Fakt_Miks",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Zrodlo = Odbc.Query(\"Driver={SQLite3 ODBC Driver};Database=\" & PlikBazy, \"SELECT * FROM pbi_fakt_miks\"),",
                "    Typy = Table.TransformColumnTypes(Zrodlo, {{\"Data\", type date}, {\"Godzina\", Int64.Type}, {\"KodZrodla\", type text}, {\"Generacja_MW\", type number}}, \"en-US\")",
                "in",
                "    Typy"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Średnia generacja (MW)",
            "expression": "DIVIDE(SUM(Fakt_Miks[Generacja_MW]), COUNTROWS(Fakt_KSE_Godzinowy))",
            "formatString": "#,0"
          },
          {
            "name": "Produkcja energii (GWh)",
            "expression": "SUM(Fakt_Miks[Generacja_MW]) / 1000",
            "formatString": "#,0.0"
          },
          {
            "name": "Udział OZE w produkcji (%)",
            "expression": [
              "DIVIDE(CALCULATE(SUM(Fakt_Miks[Generacja_MW]), Dim_Zrodlo[Kategoria] = \"OZE\"),",
              "       CALCULATE(SUM(Fakt_Miks[Generacja_MW]), Dim_Zrodlo[Kategoria] <> \"magazynowanie\"))"
            ],
            "formatString": "0.0%"
          },
          {
            "name": "Udział w produkcji (%)",
            "expression": [
              "DIVIDE(SUM(Fakt_Miks[Generacja_MW]),",
              "       CALCULATE(SUM(Fakt_Miks[Generacja_MW]), ALL(Dim_Zrodlo)))"
            ],
            "formatString": "0.0%"
          }
        ]
      },
      {
